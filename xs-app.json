{
  "welcomeFile": "index.html",
  "resources": {
    "directory": "./dist"
  },
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "inspectpro-backend",
      "csrfProtection": false,
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "index.html",
      "localDir": "./dist",
      "cacheControl": "no-cache, no-store, must-revalidate"
    }
  ]
}
